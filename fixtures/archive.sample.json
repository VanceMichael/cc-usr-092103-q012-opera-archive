    { "id": "G002", "name": "中路梆子", "aliases": ["晋剧", "太原梆子"], "included_in_38": true, "origin": { "text": "清代由蒲州梆子北上结合中路方言音调演变，成型于晋中、太原一带。", "certainty": "established", "source_ids": ["S004"] } },
    { "id": "G003", "name": "北路梆子", "aliases": ["上路调"], "included_in_38": true, "origin": { "text": "蒲州梆子流布晋北后形成，活动于忻州、大同一线。", "certainty": "established", "source_ids": ["S004"] } },
    { "id": "G004", "name": "上党梆子", "aliases": ["上党宫调", "东路戏"], "included_in_38": true, "origin": { "text": "形成于晋东南上党地区，清代融合昆、梆、罗、卷、黄五种声腔。", "certainty": "established", "source_ids": ["S004"] } },
    { "id": "G005", "name": "上党落子", "aliases": ["黎城落子"], "included_in_38": true, "origin": { "text": "清代道光年间由河北落子传入上党后本地化形成。", "certainty": "established" } },
    { "id": "G006", "name": "眉户", "aliases": ["晋南眉户", "迷胡"], "included_in_38": true, "origin": { "text": "一说源自晋南民间小曲，一说由陕西华阴、华县一带传入后本土化，两说均有曲调内证。", "certainty": "contested", "source_ids": ["S004"] }, "note": "源流两说并列，审定不采定一说。" },
    { "id": "G007", "name": "上党二簧", "aliases": ["上党皮簧"], "included_in_38": true, "origin": { "text": "清代由徽汉二簧路子传入上党地区，与上党梆子同台共生。", "certainty": "established" } },
    { "id": "G008", "name": "耍孩儿", "aliases": ["咳咳腔"], "included_in_38": true, "origin": { "text": "流布于大同、怀仁、应县一带，以咳腔衬字得名，形成年代无可靠记载。", "certainty": "unknown" } },
    { "id": "G009", "name": "灵丘罗罗腔", "aliases": ["罗罗腔"], "included_in_38": true, "origin": { "text": "清代由外地罗罗腔传至灵丘一带本地化，曾与北路梆子合班。", "certainty": "established" } },
    { "id": "G010", "name": "孝义碗碗腔", "aliases": ["碗碗腔"], "included_in_38": true, "origin": { "text": "原为皮影说唱，清末以来在孝义逐步由影戏登台为真人扮演。", "certainty": "established" } },
    { "id": "G011", "name": "曲沃碗碗腔", "included_in_38": true, "origin": { "text": "碗碗腔流布晋南曲沃一路的支派，与孝义碗碗腔同源异流。", "certainty": "established" } },
    { "id": "G012", "name": "孝义皮腔", "aliases": ["纸窗腔"], "included_in_38": true, "origin": { "text": "孝义本地皮影戏唱腔，因以纸窗亮影得名，形成年代无考。", "certainty": "unknown" } },
    { "id": "G013", "name": "锣鼓杂戏", "aliases": ["铙鼓杂戏", "杂戏"], "included_in_38": true, "origin": { "text": "流传于临猗一带农村的仪式性戏剧，以锣鼓伴奏、无弦索，被视为古老戏剧遗存。", "certainty": "established", "source_ids": ["S004"] } },
    { "id": "G014", "name": "晋北道情", "aliases": ["神池道情", "右玉道情"], "included_in_38": true, "origin": { "text": "由道情说唱在晋北登台演化，神池、右玉各有路数。", "certainty": "established" } },
    { "id": "G015", "name": "临县道情", "included_in_38": true, "origin": { "text": "道情流布吕梁临县一路，与当地民歌、法事音乐结合而成。", "certainty": "established" } },
    { "id": "G016", "name": "洪洞道情", "included_in_38": true, "origin": { "text": "道情流布晋南洪洞一路的支派。", "certainty": "established" } },
    { "id": "G017", "name": "河曲二人台", "aliases": ["二人台"], "included_in_38": true, "origin": { "text": "晋、陕、蒙交界小曲小戏在河曲一带成型，蒙汉曲调并存。", "certainty": "established" } },
    { "id": "G018", "name": "左权小花戏", "aliases": ["小花戏"], "included_in_38": true, "origin": { "text": "由左权社火歌舞逐步扮演故事而成。", "certainty": "established" } },
    { "id": "G019", "name": "祁太秧歌", "aliases": ["晋中秧歌", "太谷秧歌"], "included_in_38": true, "origin": { "text": "祁县、太谷一带民间小调发展为戏曲形态，清代已盛。", "certainty": "established" } },
    { "id": "G020", "name": "太原秧歌", "included_in_38": true, "origin": { "text": "太原城郊秧歌登台扮演形成的小剧种。", "certainty": "established" } },
    { "id": "G021", "name": "襄武秧歌", "included_in_38": true, "origin": { "text": "襄垣、武乡秧歌合流而成的上党地区秧歌戏。", "certainty": "established" } },
    { "id": "G022", "name": "壶关秧歌", "included_in_38": true, "origin": { "text": "壶关一带干板秧歌发展为舞台小戏。", "certainty": "established" } },
    { "id": "G023", "name": "泽州秧歌", "included_in_38": true, "origin": { "text": "古泽州（今晋城一带）的板腔体秧歌戏。", "certainty": "established" } },
    { "id": "G024", "name": "汾孝秧歌", "included_in_38": true, "origin": { "text": "汾阳、孝义一带秧歌戏曲化形成。", "certainty": "established" } },
    { "id": "G025", "name": "朔县大秧歌", "aliases": ["朔县秧歌"], "included_in_38": true, "origin": { "text": "朔州一带大戏路子秧歌，兼受北路梆子影响。", "certainty": "established" } },
    { "id": "G026", "name": "广灵秧歌", "included_in_38": true, "origin": { "text": "广灵及晋冀交界一带的秧歌戏，与河北西路秧歌互有交流。", "certainty": "established" } },
    { "id": "G027", "name": "沁源秧歌", "included_in_38": true, "origin": { "text": "沁源山区民歌小调经扮演化而成。", "certainty": "unknown" } },
    { "id": "G028", "name": "凤台小戏", "included_in_38": true, "origin": { "text": "和顺县凤台村一带的民间小戏，清末已有演出记录。", "certainty": "established" } },
    { "id": "G029", "name": "平陆高调", "included_in_38": true, "origin": { "text": "平陆黄河沿岸的高腔小戏，形成年代无考。", "certainty": "unknown" } },
    { "id": "G030", "name": "浮山乐乐腔", "aliases": ["乐乐腔"], "included_in_38": true, "origin": { "text": "浮山地方小戏，以伴奏和腔形态得名，源流缺文献佐证。", "certainty": "unknown" } },
    { "id": "G031", "name": "河东线腔", "aliases": ["线腔戏"], "included_in_38": true, "origin": { "text": "晋南黄河沿岸提线木偶唱腔，后亦有真人扮演。", "certainty": "established" } },
    { "id": "G032", "name": "芮城扬高戏", "aliases": ["扬高戏", "秧歌戏?"], "included_in_38": true, "origin": { "text": "芮城黄河滩一带地方小戏，名称来源有登高演唱与扬调高腔两说。", "certainty": "contested" } },
    { "id": "G033", "name": "夏县蛤蟆嗡", "aliases": ["蛤蟆嗡"], "included_in_38": true, "origin": { "text": "夏县小戏，因主奏琴头似蛙、声如蛙鸣得名，形成年代无考。", "certainty": "unknown" } },
    { "id": "G034", "name": "万荣清戏", "aliases": ["清戏"], "included_in_38": true, "origin": { "text": "万荣一带高腔系古老剧种，或与明清青阳腔遗响有关。", "certainty": "contested" } },
    { "id": "G035", "name": "弦儿戏", "included_in_38": true, "origin": { "text": "晋南以弦索伴奏的地方小戏，流布范围很小，形成年代无考。", "certainty": "unknown" } },
    { "id": "G036", "name": "赛戏", "aliases": ["赛赛"], "included_in_38": true, "origin": { "text": "晋北祭祀赛社演出的仪式戏，与傩戏的源流关系尚有争议。", "certainty": "contested", "source_ids": ["S004"] }, "note": "FC002 提出过源流更正，尚未获专家签署。" },
